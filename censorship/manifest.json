{
    "manifest_version": 3,
    "name": "Cyberbullying Filter",
    "version": "1.0",
    "description": "Detects and highlights abusive words on web pages.",
    "permissions": ["storage"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["content.js"]
    }],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    }
}
